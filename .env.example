APP_URL=http://localhost:3000
DATABASE_URL=postgres://user:pass@host-pooler.neon.tech/db?sslmode=require
DATABASE_URL_UNPOOLED=postgres://user:pass@host.neon.tech/db?sslmode=require
CRON_SECRET=

SESSION_SECRET=
# RSA public key from Admin 2's PAY_ADMIN_IDENTITY_PRIVATE_KEY (escaped newlines allowed).
ADMIN_IDENTITY_PUBLIC_KEY=
PIN_PEPPER=
CONTACT_PEPPER=
NOTIFICATIONS_SERVICE_URL=
NOTIFICATIONS_SERVICE_API_KEY=
EMAIL_DRIVER=log
SMTP_URL=
EMAIL_FROM="Spurs Pay <no-reply@example.com>"

# Register Spurs Pay as a first-party confidential OIDC client.
# Redirect URI: ${APP_URL}/auth/callback
# Post-logout URI: ${APP_URL}/signed-out
ACCOUNTS_ISSUER=https://node-accounts-backend.onrender.com/api/oidc
ACCOUNTS_CLIENT_ID=
ACCOUNTS_CLIENT_SECRET=

PAYMENTS_WEBHOOK_TOKEN=
ADMIN_CONFIG_URL=https://admin.example.com/api/config
ADMIN_BOOTSTRAP_SECRET=same-value-as-ADMIN_BOOTSTRAP_SECRET-on-admin-2

# Optional local override for service-client grants. In production, Pay should read these
# from Admin 2's /api/config?app=pay response. Each client needs the pay:service scope in
# Accounts, and Pay's own client plus the pay product are always blocked.
SERVICE_CLIENTS=
# e.g. SERVICE_CLIENTS=spurs-wallet=wallet
